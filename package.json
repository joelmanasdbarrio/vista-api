{
  "version": "0.1.0",
  "name": "@joelmanasdbarrio/vista-api",
  "author": {
    "name": "Joel Mañas del Barrio",
    "email": "joelmanasdbarrio@gmail.com",
    "url": "https://www.linkedin.com/in/joel-ma%C3%B1as-del-barrio/"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "npm run init-local-dependencies && cross-env NODE_ENV=development npm run dev",
    "init-local-dependencies": "docker-compose -f docker/docker-compose.yml up -d",
    "stop-local-dependencies": "docker-compose -f docker/docker-compose.yml down",
    "setup-local-dependencies": "npm run init-local-dependencies && cross-env node tools/setupLocalDependencies.js",
    "wrangler:deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "wrangler-secret:put": "wrangler secret put",
    "drizzle:generate": "npx drizzle-kit generate",
    "drizzle:migrate": "npx drizzle-kit migrate",
    "types:generate": "npx openapi-typescript ./node_modules/@joelmanasdbarrio/vista-spec/openapi/openapi-rest.yaml --output ./src/types/schema/vista-spec.schema.ts --path-params-as-types",
    "lint:fix": "ts-standard --fix \"src/**/*.ts\"",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.3",
    "@supabase/supabase-js": "^2.75.0",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.10",
    "postgres": "^3.4.7",
    "uuid": "^13.0.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@joelmanasdbarrio/vista-spec": "1.1.2-dev.105",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.9",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.5",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4",
    "ts-standard": "^12.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joelmanasdbarrio/vista-api.git"
  }
}
