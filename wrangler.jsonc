{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vista-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NODE_ENV": "development",
    // -- Grafana
    "GRAFANA_ENABLED": "false",
    "GRAFANA_HOST": "https://logs-prod-012.grafana.net",
    // "GRAFANA_AUTH": "", //SECRET
    "GRAFANA_LABELS_HOSTNAME": "vista-api"
    // -- Supabase
    // "SUPABASE_JWT_SECRET": "", //SECRET
  }
}